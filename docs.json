{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Hydrafetch",
  "description": "Turn any URL into clean Markdown and structured data your model can use. Scrape, crawl, search and extract with one API, one credit a page.",
  "colors": {
    "primary": "#0E7490",
    "light": "#22D3EE",
    "dark": "#22D3EE"
  },
  "appearance": {
    "default": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/lockup-light.svg",
    "dark": "/logo/lockup-dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "Chivo",
      "source": "/fonts/Chivo[wght].woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Chivo",
      "source": "/fonts/Chivo[wght].woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "icon": "/icons/rocket.svg",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core concepts",
            "icon": "/icons/book.svg",
            "pages": [
              "concepts/formats",
              "concepts/quality",
              "concepts/untrusted-content",
              "concepts/credits",
              "concepts/brand",
              "concepts/caching",
              "concepts/jobs-and-webhooks",
              "concepts/errors"
            ]
          },
          {
            "group": "Web Scraping",
            "icon": "/icons/markdown.svg",
            "pages": [
              "endpoints/scrape",
              "endpoints/map",
              "endpoints/crawl",
              "endpoints/batch",
              "endpoints/search",
              "endpoints/media",
              "endpoints/logo"
            ]
          },
          {
            "group": "Web Extraction",
            "icon": "/icons/brackets-sparkle.svg",
            "pages": [
              "endpoints/extract"
            ]
          }
        ]
      },
      {
        "tab": "Blueprints",
        "groups": [
          {
            "group": "Start here",
            "icon": "/icons/route.svg",
            "pages": [
              "blueprints/overview"
            ]
          },
          {
            "group": "Get data out of a site",
            "icon": "/icons/spider-web.svg",
            "pages": [
              "blueprints/rag-corpus",
              "blueprints/catalogue-to-rows",
              "blueprints/documents-to-markdown",
              "blueprints/watch-a-site"
            ]
          },
          {
            "group": "Answer questions and feed agents",
            "icon": "/icons/sparkle.svg",
            "pages": [
              "blueprints/answer-with-sources",
              "blueprints/agent-web-access"
            ]
          },
          {
            "group": "Know who you are dealing with",
            "icon": "/icons/target.svg",
            "pages": [
              "blueprints/local-business-directory",
              "blueprints/lead-enrichment",
              "blueprints/match-a-customer-brand",
              "blueprints/directory-logos"
            ]
          }
        ]
      },
      {
        "tab": "Help Center",
        "groups": [
          {
            "group": "Your account",
            "pages": [
              "help/account",
              "help/api-keys",
              "help/team"
            ]
          },
          {
            "group": "Plans and billing",
            "pages": [
              "help/billing"
            ]
          },
          {
            "group": "Getting unstuck",
            "pages": [
              "help/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "https://api.hydrafetch.com/openapi.json"
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@hydrafetch.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start for free",
      "href": "https://app.hydrafetch.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hydrafetch",
      "x": "https://x.com/hydrafetch"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.hydrafetch.com"
          },
          {
            "label": "Quickstart",
            "href": "https://docs.hydrafetch.com/quickstart"
          },
          {
            "label": "API reference",
            "href": "https://docs.hydrafetch.com/api-reference"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "Changelog",
            "href": "https://docs.hydrafetch.com/changelog"
          },
          {
            "label": "Status",
            "href": "https://api.hydrafetch.com/health"
          },
          {
            "label": "Support",
            "href": "mailto:team@hydrafetch.com"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "Hydrafetch Docs",
      "twitter:card": "summary_large_image",
      "og:description": "Turn any URL into clean Markdown and structured data your model can use. Scrape, crawl, search and extract with one API, one credit a page."
    }
  },
